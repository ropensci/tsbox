Type: Package
Package: tsbox
Title: Class-Agnostic Time Series
Version: 0.4.2
Authors@R: c(
    person("Christoph", "Sax", , "christoph.sax@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-7192-7044")),
    person("Cathy", "Chamberlin", role = "rev"),
    person("Nunes", "Matt", role = "rev")
